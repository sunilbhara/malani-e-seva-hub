# Copy to .env (local) and set the same VITE_* values in Netlify → Site configuration → Environment variables.
# Never commit .env. Only VITE_* values reach the browser — never put a secret behind VITE_.

# --- Supabase (Mumbai project) ---
VITE_SUPABASE_URL=https://lncyzrytctqijvhjprtu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SITE_URL=https://malanibarmer.com

# --- Analytics / ads (optional) ---
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_ADSENSE_SLOT=0000000000
VITE_GOOGLE_MAPS_API_KEY=

# --- Engagement (optional; each feature hides itself when empty) ---
VITE_VAPID_PUBLIC_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_WHATSAPP_CHANNEL_URL=
VITE_TELEGRAM_CHANNEL_URL=
VITE_NEWSLETTER_ENABLED=false

# --- EmailJS (contact / studio booking forms) ---
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_TEMPLATE_ID_MATAJI_STUDIO=
VITE_EMAILJS_PUBLIC_KEY=

