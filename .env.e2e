# Playwright build (vite build --mode e2e). Overrides .env and .env.local.
# Points at a fake Supabase host that the tests answer in-browser, so E2E never touches real data.
VITE_SUPABASE_URL=https://e2e-mock.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e2e_mock_key
VITE_SITE_URL=https://malanibarmer.com
VITE_GOOGLE_ANALYTICS_ID=
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
VITE_GOOGLE_MAPS_API_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/e2e-test
VITE_TELEGRAM_CHANNEL_URL=https://t.me/e2e_test
VITE_NEWSLETTER_ENABLED=true
VITE_EMAILJS_SERVICE_ID=e2e_service
VITE_EMAILJS_TEMPLATE_ID=e2e_template
VITE_EMAILJS_TEMPLATE_ID_MATAJI_STUDIO=e2e_template_studio
VITE_EMAILJS_PUBLIC_KEY=e2e_public
