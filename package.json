{
  "name": "malani-barmer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:functions": "npx --yes deno test --no-config --node-modules-dir=none --allow-env --allow-import supabase/functions/tests netlify/tests",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "db:apply": "node scripts/apply-migration.mjs",
    "db:migrate-region": "node scripts/migrate-region.mjs",
    "verify:anon-blog": "node scripts/verify-anon-blog.mjs",
    "test:unit": "vitest run src/lib src/services src/components",
    "test:integration": "vitest run src/pages src/__tests__",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:db": "echo \"Run supabase/tests/database.test.sql in the Supabase SQL editor (it rolls back)\"",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:functions && npm run test:e2e"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.56.2",
    "@tiptap/extension-image": "^3.23.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-text-align": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.2",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^6.26.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "transliteration": "^2.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "lovable-tagger": "^1.1.7",
    "pg": "^8.23.0",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.22.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
